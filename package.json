{
  "name": "claude-maestro",
  "version": "0.2.0",
  "description": "Maestro — conduct Claude Code: resume any past session in its original folder, a settings.json catalog across scopes, hard guardrails, a library manager, and exact per-session token and cost accounting.",
  "bin": {
    "claude-maestro": "./server.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node selftest.js",
    "build:icon": "node tools/make-icon.js",
    "build:exe": "powershell -ExecutionPolicy Bypass -File tools/build-launcher.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {},
  "files": [
    "server.js",
    "lib",
    "selftest.js",
    "public",
    "assets",
    "tools",
    "start.sh",
    "start.cmd",
    "Maestro.exe",
    "README.md"
  ],
  "preferGlobal": true
}
